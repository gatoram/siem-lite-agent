# Скопіюй у .env і заповни. Сам .env не комітиться (.gitignore).

# LLM-провайдер агента: gemini
LLM_PROVIDER=gemini

# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# https://www.abuseipdb.com/account/api
ABUSEIPDB_API_KEY=

# Telegram-сповіщення: токен від @BotFather, chat_id — свій чат з ботом
# (напиши боту, потім https://api.telegram.org/bot<TOKEN>/getUpdates)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
